{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
    ':semanticCommits',
  ],
  rebaseWhen: 'auto',
  rebaseLabel: 'rebase',
  prConcurrentLimit: 5,
  autoApprove: true,
  automerge: true,
  automergeType: 'pr',
  baseBranches: [
    'main',
  ],
  labels: [
    'automated',
  ],
  ignorePaths: [ // default renovate ignorePaths without '**/examples/**'
    '**/node_modules/**',
    '**/bower_components/**',
    '**/vendor/**',
    '**/__tests__/**',
    '**/test/**',
    '**/tests/**',
    '**/__fixtures__/**'
  ],
  crossplane: {
    fileMatch: ['(^|/)examples/.*\\.ya?ml$', '^apis/crossplane\\.yaml$']
  },
  packageRules: [
    {
      matchFileNames: [
        '.github/**',
      ],
      groupName: 'github-actions dependencies',
    },
    {
      matchFileNames: [
        'apis/crossplane.yaml',
      ],
      groupName: 'crossplane dependencies',
    },
    {
      matchManagers: ['crossplane'],
      matchFileNames: ['examples/**'],
      groupName: 'examples'
    },
  ],
  "git-submodules": {
     "enabled": true
  }
}
